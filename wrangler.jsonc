{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deniz-estate-property",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    { "pattern": "www.deniz-estate.property/*", "zone_id": "70714c8b3de452af5f69126b9cc6acfd" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deniz-estate-leads",
      "database_id": "7a35b81d-dc12-42a0-9582-fd804580da27",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "LEADS_ENABLED": "true" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
  // Основной Custom Domain сохранён в панели; маршрут www закреплён выше.
  // keep_vars сохраняет переменные панели, кроме явно заданного выше LEADS_ENABLED=true.
  // Ключи Telegram, Resend и шифрования добавляются только как Cloudflare Secrets.
}
