{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deniz-estate-property",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "LEADS_ENABLED": "false" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
  // После создания D1 добавьте d1_databases по инструкции docs/CLOUDFLARE_SETUP.md.
  // Ключи Telegram, Resend и шифрования добавляются только как Cloudflare Secrets.
}
